default partial alphanumeric_keys
xkb_symbols "graphite" {
    name[Group1]= "Graphite";

    key <TLDE> { [    grave, asciitilde,  dead_grave,       dead_tilde ] };
    key <AE01> { [        1,     exclam,  onesuperior,      exclamdown ] };
    key <AE02> { [        2,         at, twosuperior, dead_doubleacute ] };
    key <AE03> { [        3, numbersign,threesuperior,      dead_macron ] };
    key <AE04> { [        4,     dollar,     currency,         sterling ] };
    key <AE05> { [        5,    percent,     EuroSign,     dead_cedilla ] };
    key <AE06> { [        6,asciicircum,dead_circumflex,      onequarter ] };
    key <AE07> { [        7,  ampersand,     dead_horn,          onehalf ] };
    key <AE08> { [        8,   asterisk,   dead_ogonek,   threequarters ] };
    key <AE09> { [        9, parenleft,leftsinglequotemark,   dead_breve ] };
    key <AE10> { [        0,parenright,rightsinglequotemark,dead_abovering] };
    key <AE11> { [bracketleft, braceleft,          yen,    dead_belowdot ] };
    key <AE12> { [bracketright,braceright,    multiply,        division ] };

    key <AD01> { [ b, B, adiaeresis,      Adiaeresis ] };
    key <AD02> { [ l, L,      aring,           Aring ] };
    key <AD03> { [ d, D,     eacute,          Eacute ] };
    key <AD04> { [ w, W,  ediaeresis,       Ediaeresis ] };
    key <AD05> { [ z, Z,      thorn,            THORN ] };
    key <AD06> { [apostrophe,underscore, udiaeresis, Udiaeresis ] };
    key <AD07> { [ f, F,     uacute,          Uacute ] };
    key <AD08> { [ o, O,     iacute,          Iacute ] };
    key <AD09> { [ u, U,     oacute,          Oacute ] };
    key <AD10> { [ j, J, odiaeresis,       Odiaeresis ] };
    key <AD11> { [ semicolon, colon, guillemotleft, leftdoublequotemark ] };
    key <AD12> { [   equal, plus, guillemotright, rightdoublequotemark ] };

    key <AC01> { [ n, N,     aacute,          Aacute ] };
    key <AC02> { [ r, R,     ssharp,          section ] };
    key <AC03> { [ t, T,        eth,             ETH ] };
    key <AC04> { [ s, S,          f,               F ] };
    key <AC05> { [ g, G,          g,               G ] };
    key <AC06> { [ y, Y,          h,               H ] };
    key <AC07> { [ h, H, idiaeresis,       Idiaeresis ] };
    key <AC08> { [ a, A,         oe,              OE ] };
    key <AC09> { [ e, E,     oslash,          Oslash ] };
    key <AC10> { [ i, I,   paragraph,          degree ] };
    key <AC11> { [  comma, question,   dead_acute,    dead_diaeresis ] };

    key <AB01> { [ q, Q,         ae,              AE ] };
    key <AB02> { [ x, X,         oe,              OE ] };
    key <AB03> { [ m, M,  copyright,            cent ] };
    key <AB04> { [ c, C, registered,       trademark ] };
    key <AB05> { [ v, V,periodcentered,    dead_stroke ] };
    key <AB06> { [ k, K,     ntilde,          Ntilde ] };
    key <AB07> { [ p, P,         mu,        plusminus ] };
    key <AB08> { [period, greater,   ccedilla,      Ccedilla ] };
    key <AB09> { [  minus,quotedbl,dead_abovedot,     dead_caron ] };
    key <AB10> { [  slash,   less, questiondown,      dead_hook ] };
    key <BKSL> { [backslash,  bar,     notsign,      brokenbar ] };

    include "level3(ralt_switch)"
};
